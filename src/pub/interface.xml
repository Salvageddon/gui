<?xml version="1.0" encoding="UTF-8"?>
<linearView orientation="vertical"
            padding="5"
            width="size-min"
            height="size-min"
            item-alignment="start start">
    <linearView orientation="horizontal"
                width="size-min"
                height="size-min"
                item-alignment="start start">
        <button height="50%" width="50%" margin="5" text="Hemlo hooman" text-size="20" id="#A00"/>
        <button height="50%" width="50%" margin="5" text="We are buttons :3" text-size="20" disabled="true"/>
    </linearView>

    <linearView orientation="horizontal"
                width="size-min"
                height="size-min"
                item-alignment="start start">
        <button height="50%" width="50%" margin="5" text="Next to me is a view -->" text-size="20"/>
        <view height="50%" width="50%" margin="5"/>
    </linearView>
</linearView>