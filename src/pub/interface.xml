<?xml version="1.0" encoding="UTF-8"?>
<linearView orientation="vertical"
            height="size-min"
            width="size-min"
            margin="10"
            padding="5"
            item-alignment="start start">
    <linearView orientation="horizontal"
                height="50%"
                width="size-min"
                padding="5"
                margin="5"
                item-alignment="start start">
        <button height="100" width="50%" margin="5" text="yep, I'm a button ^w^" text-size="10"/>
        <button height="100" width="50%" margin="5"/>
    </linearView>

    <linearView orientation="vertical"
                height="50%"
                width="size-min"
                padding="5"
                margin="5"
                item-alignment="start start">
        <view height="100" width="100" margin="5"/>
        <view height="100" width="100" margin="5"/>
    </linearView>
</linearView>